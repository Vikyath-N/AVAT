# AVAT Free Infrastructure Environment Configuration
# Copy this file to .env and fill in your actual values

# === FRONTEND CONFIGURATION ===
# React App Environment Variables

# API Base URL - Points to Cloudflare Workers backend
REACT_APP_API_BASE_URL=https://avat-backend.v-naradasi.workers.dev/api/v1

# WebSocket URL (disabled for Cloudflare Workers - using polling instead)
# REACT_APP_WS_URL=wss://your-websocket-endpoint

# Mapbox Configuration (use public token for frontend)
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Application Configuration
REACT_APP_APP_NAME=AVAT
REACT_APP_VERSION=2.0.0
REACT_APP_ENVIRONMENT=production
REACT_APP_DEMO_MODE=false
REACT_APP_BASENAME=/AVAT

# Feature Flags
REACT_APP_ENABLE_REAL_TIME=false
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_EXPORT=true

# === BACKEND CONFIGURATION (Cloudflare Workers) ===
# These are set in wrangler.toml or Cloudflare dashboard

# Neon PostgreSQL Database
DATABASE_URL=postgresql://avat_app:npg_MN95PdsCTzgy@ep-aged-leaf-adig818q.c-2.us-east-1.aws.neon.tech/avat_prod?sslmode=require

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://distinct-rooster-15123.upstash.io
UPSTASH_REDIS_REST_TOKEN=ATsTAAIncDI2NDVkODQxZjE4YTg0YWVjYjQ4ZjQyMmZiZDU4NjU5NHAyMTUxMjM

# Supabase (for Auth and additional features - optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Cloudflare R2 Storage (for PDF files)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare Workers Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# === DEVELOPMENT OVERRIDES ===
# For local development, you can override the above with:
# REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
# REACT_APP_WS_URL=ws://localhost:8000/ws

# === PRODUCTION DEPLOYMENT ===
# GitHub Secrets for automated deployment:
# - MAPBOX_TOKEN: Mapbox public token
# - PROD_API_BASE_URL: Cloudflare Workers URL
# - PROD_WS_URL: (disabled for Workers)
# - CLOUDFLARE_API_TOKEN: For automated deployment
# - CLOUDFLARE_ACCOUNT_ID: For automated deployment
# - DATABASE_URL: Neon database connection string
# - UPSTASH_REDIS_REST_URL: Redis REST API URL
# - UPSTASH_REDIS_REST_TOKEN: Redis authentication token

# === MIGRATION NOTES ===
# This configuration replaces the previous Railway/Render setup with:
# - Frontend: GitHub Pages (Free)
# - Backend: Cloudflare Workers (Free tier)
# - Database: Neon PostgreSQL (Free tier)
# - Cache: Upstash Redis (Free tier)
# - Storage: Cloudflare R2 (Free tier)
#
# Total monthly cost: $0 (all services on free tiers)
# Previous cost: ~$19/month (Railway/Render)
